  "facts": [
    { "id": "fact.cold.wrap", "text": "The tonic must be wrapped at the Relay House before clinic delivery." },
    { "id": "fact.cold.tide", "text": "The Lowmere causeway remains dry through the morning." },
    { "id": "fact.cold.clinic", "text": "Reedbank Clinic accepts protected deliveries at its east counter." },
    { "id": "fact.ferry.second-bell", "text": "The repair ferry now leaves at second bell." },
    { "id": "fact.ferry.old-second-bell", "text": "The superseded ferry schedule listed noon." },
    { "id": "fact.ferry.load", "text": "The repair ferry can carry six cargo marks." },
    { "id": "fact.glass.current-pattern", "text": "The repaired beacon needs the clear lens above the blue lens." },
    { "id": "fact.glass.old-pattern", "text": "The retired beacon pattern placed blue above clear." },
    { "id": "fact.glass.key", "text": "The calibration key opens the glassworks test frame." },
    { "id": "fact.weather.squall", "text": "A fast squall requires the signed safe-bearing chart." },
    { "id": "fact.weather.cliff", "text": "The unsheltered cliff stair should be cleared before the squall." },
    { "id": "fact.weather.cove", "text": "The lee alcove is Highwake's nearest marked shelter." },
    { "id": "fact.stores.grain", "text": "Lowmere has a grain surplus this circuit." },
    { "id": "fact.stores.water", "text": "Highwake's rain tank needs a replacement seal." },
    { "id": "fact.stores.seal", "text": "The drydock's copper seal fits the Highwake rain tank." },
    { "id": "fact.manifest.crate17", "text": "Crate Seventeen belongs at Reedbank Clinic, not the drydock." },
    { "id": "fact.manifest.ink", "text": "Green correction ink is used only at the Relay House." },
    { "id": "fact.manifest.revision", "text": "The current manifest revision was filed before loading." },
    { "id": "casefact.manifest.old-copy", "text": "The Ferry Yard carbon copy predates the revision." },
    { "id": "casefact.manifest.current-copy", "text": "The Relay House copy is current and countersigned." },
    { "id": "casefact.manifest.green-ink", "text": "The green correction is absent from the dispatched carbon copy." }
  ],
