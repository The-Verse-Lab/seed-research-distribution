# Seed LLM gateway configuration
# Copy to .env and adjust the OpenAI-compatible endpoints for your environment.

# Narrator: player-facing prose and NPC dialogue.
SEED_NARRATOR_BASE_URL=http://localhost:11434/v1
SEED_NARRATOR_API_KEY=ollama
SEED_NARRATOR_MODEL=llama3.1:8b

# Creative: optional stronger authoring/enrichment model; defaults to narrator.
#SEED_CREATIVE_BASE_URL=http://localhost:11434/v1
#SEED_CREATIVE_API_KEY=ollama
#SEED_CREATIVE_MODEL=llama3.1:8b

# Utility: intent extraction and verification work.
SEED_UTILITY_BASE_URL=http://localhost:11434/v1
SEED_UTILITY_API_KEY=ollama
SEED_UTILITY_MODEL=llama3.2:3b

# Embeddings: lore and memory retrieval.
SEED_EMBEDDING_BASE_URL=http://localhost:11434/v1
SEED_EMBEDDING_API_KEY=ollama
SEED_EMBEDDING_MODEL=nomic-embed-text

# Optional rescue route for empty or refused prose completions.
#SEED_RESCUE_BASE_URL=http://localhost:1234/v1
#SEED_RESCUE_API_KEY=lm-studio
#SEED_RESCUE_MODEL=local-prose-model

# Optional per-role reasoning controls for compatible endpoints.
#SEED_UTILITY_THINKING=off
#SEED_NARRATOR_THINKING=off
#SEED_CREATIVE_THINKING=off
#SEED_RESCUE_THINKING=off

# Continuity verification. The judge is enabled by default.
#SEED_CONTINUITY_JUDGE=off
#SEED_JUDGE_STREAM_CLEAN=on
#SEED_JUDGE_MODEL=deepseek-v4-pro

# Persistence and retrieval.
SEED_DATA_DIR=./data
#SEED_LORE_K=4
#SEED_LORE_MIN_SCORE=0.1
#SEED_LORE_CACHE=on
#SEED_SUMMARY=on
#SEED_TELEMETRY_RETENTION_DAYS=0

# Optional model-specific instruction prepended to GM/NPC system prompts.
SEED_SYSTEM_PREFIX=

# Per-request inactivity timeout while streaming, in milliseconds.
SEED_REQUEST_TIMEOUT_MS=60000

# Development-only inline trace surfacing. Traces are persisted regardless.
#SEED_DEV_TRACE=1
